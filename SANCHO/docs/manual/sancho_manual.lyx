\begin_layout Section
Model
\end_layout

\begin_layout Standard
Units:
 energies in eV,
 voltages in V,
 temperatures in K,
 
\begin_inset Formula $\hbar=e=1$
\end_inset

 (factors of 
\begin_inset Formula $\hbar$
\end_inset

 are kept in the equations and in the source),
 and 
\begin_inset Formula $k_{B}=8.6173303\times10^{-5}$
\end_inset


\begin_inset space ~
\end_inset

eV/K.
\end_layout

\begin_layout Subsection
Hamiltonian
\end_layout

\begin_layout Standard
A chain of 
\begin_inset Formula $N$
\end_inset

 sites (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
Nsites
\end_layout

\end_inset

) with one orbital per site:
 
\begin_inset Formula 
\begin{equation}
H=\sum_{i}\varepsilon\,n_{i}+t\sum_{i}\bigl(c_{i}^{\dagger}c_{i+1}+\text{h.c.}\bigr)+\sum_{i}U_{i}\,n_{i\uparrow}n_{i\downarrow},
\end{equation}

\end_inset

with 
\begin_inset Formula $\varepsilon$
\end_inset

 = 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
E_CC
\end_layout

\end_inset

,
 
\begin_inset Formula $t$
\end_inset

 = 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
t_hop
\end_layout

\end_inset

,
 and 
\begin_inset Formula $U_{i}$
\end_inset

 = 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
U_int
\end_layout

\end_inset

,
 or one value per site from 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
hubbard_file
\end_layout

\end_inset

.
 Spin enters only through the interaction,
 and the solution is assumed paramagnetic,
 so the Green's functions are 
\begin_inset Formula $N\times N$
\end_inset

 matrices for one spin species (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
build_chain_hamiltonian
\end_layout

\end_inset

 in 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
src/hamiltonian.f90
\end_layout

\end_inset

).
\end_layout

\begin_layout Standard
This chain is only one choice: nothing else in the code depends on it, and any other spin-independent single-particle Hamiltonian can be used instead, as described in the section 
\emph on
Using your own Hamiltonian
\emph default
.
\end_layout


\begin_layout Subsection
Leads
\end_layout

\begin_layout Standard
Wide-band leads:
 
\begin_inset Formula $\Gamma_{L}$
\end_inset

 couples to site 1,
 
\begin_inset Formula $\Gamma_{R}$
\end_inset

 to site 
\begin_inset Formula $N$
\end_inset

 (
\begin_inset Formula $\Gamma_{L}$
\end_inset

 = 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
GammaL
\end_layout

\end_inset

,
 
\begin_inset Formula $\Gamma_{R}$
\end_inset

 = 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
GammaR
\end_layout

\end_inset

,
 default 1
\begin_inset space ~
\end_inset

eV each).
 The bias is applied to the left lead only:
 
\begin_inset Formula 
\begin{equation}
f_{L}(\omega)=\frac{1}{e^{\beta(\omega-\mu+V)}+1},\qquad f_{R}(\omega)=\frac{1}{e^{\beta(\omega-\mu)}+1},
\end{equation}

\end_inset

i.e.
\begin_inset space \space{}
\end_inset


\begin_inset Formula $\mu_{L}=\mu-V$
\end_inset

,
 
\begin_inset Formula $\mu_{R}=\mu$
\end_inset

.
 With 
\begin_inset Formula $U\neq0$
\end_inset

 the asymmetric bias makes the 
\begin_inset Formula $I$
\end_inset

–
\begin_inset Formula $V$
\end_inset

 curve not exactly odd in 
\begin_inset Formula $V$
\end_inset

.
\end_layout

\begin_layout Section
Non-equilibrium Green's functions
\end_layout

\begin_layout Subsection
Energy grid
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\omega_{k}=\omega_{\text{init}}+k\delta,\quad k=1,\dots,N_{\omega},\qquad\omega_{\text{init}}=\epsilon_{\text{min}}-\code{dw},\qquad N_{\omega}=\Bigl\lfloor\frac{\epsilon_{\text{max}}+\code{up}-\omega_{\text{init}}}{\delta}\Bigr\rfloor.
\end{equation}

\end_inset


\end_layout

\begin_layout Subsection
Dyson and Keldysh equations
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align}
\Gr(\omega) & =\Bigl[\hbar\omega-H+\tfrac{i}{2\hbar}(\Gamma_{L}+\Gamma_{R})-\Sigma^{r}(\omega)\Bigr]^{-1},\qquad\Ga=(\Gr)^{\dagger},\label{eq:dyson}\\
\Gl(\omega) & =\Gr(\omega)\Bigl[\tfrac{i}{\hbar}\bigl(f_{L}\Gamma_{L}+f_{R}\Gamma_{R}\bigr)+\Sigma^{<}(\omega)\Bigr]\Ga(\omega),\\
\Gg(\omega) & =\Gl(\omega)+\Gr(\omega)-\Ga(\omega).\label{eq:greater}
\end{align}

\end_inset


\end_layout

\begin_layout Subsection
Occupations and current
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\Gl_{ii}(t{=}0)=\frac{\delta}{2\pi}\sum_{k}\Gl_{ii}(\omega_{k}),\qquad n_{i}=-i\hbar\,\Gl_{ii}(t{=}0)\ \ \text{(per spin)},
\end{equation}

\end_inset


\begin_inset Formula 
\begin{equation}
J=2\cdot\frac{1}{\hbar}\frac{\delta}{2\pi}\sum_{k}\operatorname{Re}\Tr\Bigl\{ i\Gamma_{L}\Bigl[\bigl(f_{L}-1\bigr)\Gl(\omega_{k})-f_{L}\Gg(\omega_{k})\Bigr]\Bigr\},
\end{equation}

\end_inset

where the factor 2 is the spin degeneracy.
 The bracket equals 
\begin_inset Formula $-[\Gl+f_{L}(\Gr-\Ga)]$
\end_inset

,
 so this is minus the Meir–Wingreen expression;
 with this sign 
\begin_inset Formula $J>0$
\end_inset

 for 
\begin_inset Formula $V>0$
\end_inset

.
\end_layout

\begin_layout Section
Interaction self-energies
\end_layout

\begin_layout Standard
All self-energies are built from the input Green's functions 
\begin_inset Formula $G$
\end_inset

 of the current SCF step (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
src/self_energies.f90
\end_layout

\end_inset

,
 first order in 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
interacting_gf
\end_layout

\end_inset

).
 Grid sums carry the weight 
\begin_inset Formula $p=\delta/2\pi$
\end_inset

.
\end_layout

\begin_layout Subsection
First order (Hartree),
 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
order
\end_layout

\end_inset

 
\begin_inset Formula $\ge1$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\Sigma_{ij}^{(1)r}=-i\hbar\,U_{i}\,\Gl_{ii}(t{=}0)\,\delta_{ij}=U_{i}\,n_{i}\,\delta_{ij}.
\end{equation}

\end_inset

In the paramagnetic chain the opposite-spin density equals 
\begin_inset Formula $n_{i}$
\end_inset

,
 and the Fock term (same spin) does not appear for an on-site 
\begin_inset Formula $Un_{\uparrow}n_{\downarrow}$
\end_inset

 interaction.
\end_layout

\begin_layout Subsection
Bubbles
\end_layout

\begin_layout Standard
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
compute_bubbles
\end_layout

\end_inset

 first copies 
\begin_inset Formula $G$
\end_inset

 with the energy index first (contiguous loops),
 then forms,
 for every pair 
\begin_inset Formula $(a,b)$
\end_inset

:
\end_layout

\begin_layout Standard

\emph on
Particle–hole bubbles
\emph default
 at transfer 
\begin_inset Formula $\nu_{m}=m\delta$
\end_inset

,
 
\begin_inset Formula $m=-(N_{\omega}-1),\dots,N_{\omega}-1$
\end_inset

:
 
\begin_inset Formula 
\begin{align}
\chi_{ab}^{>}(\nu_{m}) & =p\sum_{k}\Gg_{ab}(\omega_{k})\,\Gl_{ba}(\omega_{k}-\nu_{m}),\nonumber \\
\chi_{ab}^{<}(\nu_{m}) & =p\sum_{k}\Gl_{ab}(\omega_{k})\,\Gg_{ba}(\omega_{k}-\nu_{m}),\nonumber \\
\chi_{ab}^{r}(\nu_{m}) & =p\sum_{k}\bigl[\Gr_{ab}(\omega_{k})\Gl_{ba}(\omega_{k}-\nu_{m})+\Gl_{ab}(\omega_{k})\Ga_{ba}(\omega_{k}-\nu_{m})\bigr],\\
\chi_{ab}^{a}(\nu_{m}) & =p\sum_{k}\bigl[\Ga_{ab}(\omega_{k})\Gl_{ba}(\omega_{k}-\nu_{m})+\Gl_{ab}(\omega_{k})\Gr_{ba}(\omega_{k}-\nu_{m})\bigr].\nonumber 
\end{align}

\end_inset


\emph on
Particle–particle bubbles
\emph default
 (order 3 only) at total energy 
\begin_inset Formula $\Omega_{n}=2\omega_{\text{init}}+n\delta$
\end_inset

,
 
\begin_inset Formula $n=2,\dots,2N_{\omega}$
\end_inset

:
 
\begin_inset Formula 
\begin{align}
\phi_{ab}^{>}(\Omega_{n}) & =p\sum_{k}\Gg_{ab}(\omega_{k})\Gg_{ab}(\Omega_{n}-\omega_{k}),\nonumber \\
\phi_{ab}^{<}(\Omega_{n}) & =p\sum_{k}\Gl_{ab}(\omega_{k})\Gl_{ab}(\Omega_{n}-\omega_{k}),\nonumber \\
\phi_{ab}^{r}(\Omega_{n}) & =p\sum_{k}\bigl[\Gr_{ab}\Gg_{ab}+\Gl_{ab}\Gr_{ab}\bigr],\nonumber \\
\phi_{ab}^{a}(\Omega_{n}) & =p\sum_{k}\bigl[\Ga_{ab}\Gg_{ab}+\Gl_{ab}\Ga_{ab}\bigr],
\end{align}

\end_inset

where in the last line the first factor is at 
\begin_inset Formula $\omega_{k}$
\end_inset

 and the second at 
\begin_inset Formula $\Omega_{n}-\omega_{k}$
\end_inset

.
 All sums run only over terms that stay on the grid.
\end_layout

\begin_layout Subsection
Second order,
 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
order
\end_layout

\end_inset

 
\begin_inset Formula $\ge2$
\end_inset


\end_layout

\begin_layout Standard
With 
\begin_inset Formula $c_{2}=-(i\hbar)^{2}=\hbar^{2}$
\end_inset

 (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
second_order_sigma
\end_layout

\end_inset

):
 
\begin_inset Formula 
\begin{align}
\Sigma_{ij}^{(2)<}(\omega) & =c_{2}U_{i}U_{j}\,p\sum_{m}\Gl_{ij}(\omega-\nu_{m})\,\chi_{ij}^{<}(\nu_{m}),\\
\Sigma_{ij}^{(2)>}(\omega) & =c_{2}U_{i}U_{j}\,p\sum_{m}\Gg_{ij}(\omega-\nu_{m})\,\chi_{ij}^{>}(\nu_{m}),\\
\Sigma_{ij}^{(2)r}(\omega) & =c_{2}U_{i}U_{j}\,p\sum_{m}\bigl[\Gr_{ij}(\omega-\nu_{m})\,\chi_{ij}^{>}(\nu_{m})+\Gl_{ij}(\omega-\nu_{m})\,\chi_{ij}^{r}(\nu_{m})\bigr].
\end{align}

\end_inset

In time this is the familiar second-Born form 
\begin_inset Formula $\Sigma_{ij}^{<}(t)=\hbar^{2}U_{i}U_{j}\,\Gl_{ij}(t)\Gl_{ij}(t)\Gg_{ji}(-t)$
\end_inset

.
\end_layout

\begin_layout Subsection
Third order,
 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
order
\end_layout

\end_inset

 
\begin_inset Formula $=3$
\end_inset


\end_layout

\begin_layout Standard
The third-order diagrams (the corrected Appendix
\begin_inset space ~
\end_inset

B derivation) factorise into bubble chains summed over an internal site 
\begin_inset Formula $k$
\end_inset

 (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
third_order_sigma
\end_layout

\end_inset

):
 
\begin_inset Formula 
\begin{align}
S_{ij}^{>}(\nu) & ={\textstyle \sum_{k}U_{k}\bigl[\chi_{ik}^{r}\chi_{kj}^{>}+\chi_{ik}^{>}\chi_{kj}^{a}\bigr](\nu),\nonumber}\\
S_{ij}^{<}(\nu) & ={\textstyle \sum_{k}U_{k}\bigl[\chi_{ik}^{r}\chi_{kj}^{<}+\chi_{ik}^{<}\chi_{kj}^{a}\bigr](\nu),\nonumber}\\
S_{ij}^{r}(\nu) & ={\textstyle \sum_{k}U_{k}\,\chi_{ik}^{r}\chi_{kj}^{r}(\nu),}
\end{align}

\end_inset

and 
\begin_inset Formula $P_{ij}^{>,<,r}(\Omega)$
\end_inset

 the same with 
\begin_inset Formula $\chi\to\phi$
\end_inset

.
 Then,
 with 
\begin_inset Formula $c_{3}=-(i\hbar)^{3}$
\end_inset

,
 
\begin_inset Formula 
\begin{align}
\Sigma_{ij}^{(3)<}(\omega) & =c_{3}U_{i}U_{j}\,p\Bigl[\sum_{m}\Gl_{ij}(\omega-\nu_{m})S_{ij}^{<}(\nu_{m})+\sum_{n}\Gg_{ji}(\Omega_{n}-\omega)P_{ij}^{<}(\Omega_{n})\Bigr],\\
\Sigma_{ij}^{(3)>}(\omega) & =c_{3}U_{i}U_{j}\,p\Bigl[\sum_{m}\Gg_{ij}(\omega-\nu_{m})S_{ij}^{>}(\nu_{m})+\sum_{n}\Gl_{ji}(\Omega_{n}-\omega)P_{ij}^{>}(\Omega_{n})\Bigr],\\
\Sigma_{ij}^{(3)r}(\omega) & =c_{3}U_{i}U_{j}\,p\Bigl[\sum_{m}\bigl(\Gr_{ij}S_{ij}^{>}+\Gl_{ij}S_{ij}^{r}\bigr)+\sum_{n}\bigl(\Ga_{ji}P_{ij}^{>}+\Gg_{ji}P_{ij}^{r}\bigr)\Bigr],
\end{align}

\end_inset

with the same arguments as in the first two lines.
 
\begin_inset Formula $\Sigma^{>}$
\end_inset

 is not needed by the SCF;
 it is kept so that 
\begin_inset Formula $\Sigma^{r}-\Sigma^{a}=\Sigma^{>}-\Sigma^{<}$
\end_inset

 can be checked.
\end_layout

\begin_layout Subsection
Total self-energy and cost
\end_layout

\begin_layout Standard
\begin_inset Formula $\Sigma^{r}=\Sigma^{(1)}+\Sigma^{(2)r}+\Sigma^{(3)r}$
\end_inset

 and 
\begin_inset Formula $\Sigma^{<}=\Sigma^{(2)<}+\Sigma^{(3)<}$
\end_inset

,
 up to 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
order
\end_layout

\end_inset

.
 The bubbles cost 
\begin_inset Formula $\mathcal{O}(N^{2}N_{\omega}^{2})$
\end_inset

 per SCF step;
 the third-order sums over 
\begin_inset Formula $k$
\end_inset

 add 
\begin_inset Formula $\mathcal{O}(N^{3}N_{\omega})$
\end_inset

.
 Besides 
\begin_inset Formula $8N^{2}N_{\omega}$
\end_inset

 complex numbers for 
\begin_inset Formula $G_{\text{in}}$
\end_inset

 and 
\begin_inset Formula $G_{\text{out}}$
\end_inset

,
 the self-energy work arrays take 
\begin_inset Formula $\approx15\,N^{2}N_{\omega}$
\end_inset

 complex numbers at order 2 and 
\begin_inset Formula $\approx38\,N^{2}N_{\omega}$
\end_inset

 at order 3 (the third-order arrays are allocated only when 
\begin_inset Flex Code
