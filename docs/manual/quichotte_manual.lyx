\begin_layout Subsection
Your own model in three steps
\end_layout

\begin_layout Enumerate
Edit the body of 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
build_custom_hamiltonian
\end_layout

\end_inset

, the last routine in 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
src/hamiltonian.f90
\end_layout

\end_inset

. As shipped it is a plain spin-degenerate chain (on-site 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
E_CC
\end_layout

\end_inset

, hopping 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
t_hop
\end_layout

\end_inset

, no SOC), so it runs straight away: 
\end_layout

\begin_deeper
\begin_layout Verbatim
   subroutine build_custom_hamiltonian()
\end_layout

\begin_layout Verbatim
      integer :: i, ii
\end_layout

\begin_layout Verbatim

\end_layout

\begin_layout Verbatim
      H = (0.d0, 0.d0)
\end_layout

\begin_layout Verbatim
      do i = 1, N_sites
\end_layout

\begin_layout Verbatim
         ii = 2*i                      !...ii-1 = (i,up), ii = (i,down)
\end_layout

\begin_layout Verbatim
         H(ii - 1, ii - 1) = E_CC      !...on-site energy, spin up
\end_layout

\begin_layout Verbatim
         H(ii, ii) = E_CC              !...on-site energy, spin down
\end_layout

\begin_layout Verbatim
         if (i .lt. N_sites) then      !...hop i -> i+1, spin conserving
\end_layout

\begin_layout Verbatim
            H(ii - 1, ii + 1) = t_hop  !...up   -> up
\end_layout

\begin_layout Verbatim
            H(ii, ii + 2) = t_hop      !...down -> down
\end_layout

\begin_layout Verbatim
         end if
\end_layout

\begin_layout Verbatim
      end do
\end_layout

\begin_layout Verbatim
      call make_hermitian()            !...upper triangle -> whole matrix
\end_layout

\begin_layout Verbatim
   end subroutine build_custom_hamiltonian
\end_layout

