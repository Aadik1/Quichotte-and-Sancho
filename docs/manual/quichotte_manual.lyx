\begin_layout Subsection
Basis
\end_layout

\begin_layout Standard
The molecule has 
\begin_inset Formula $N_{\text{sites}}=N_{\text{ions}}\,N_{\text{turns}}$
\end_inset

 sites with one orbital each.
 Every site carries two spin-orbitals,
 numbered 
\begin_inset Formula 
\[
2i-1=(i,\uparrow),\qquad2i=(i,\downarrow),\qquad i=1,\dots,N_{\text{sites}},
\]

\end_inset

so all matrices have dimension 
\begin_inset Formula $N_{\text{orb}}=2N_{\text{sites}}$
\end_inset

 (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
Norb
\end_layout

\end_inset

 in the code).
 The spin quantisation axis is 
\begin_inset Formula $z$
\end_inset

,
 the helix axis.
\end_layout

\begin_layout Subsection
Helix geometry
\end_layout

\begin_layout Standard
Site 
\begin_inset Formula $i$
\end_inset

 sits at (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
helix_coordinate
\end_layout

\end_inset

 in 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
src/hamiltonian.f90
\end_layout

\end_inset

) 
\begin_inset Formula 
\begin{equation}
\mathbf{r}_{i}=\Bigl(R\cos\phi_{i},\;R\sin\phi_{i},\;(i-1)\,\Delta z\Bigr),\qquad\phi_{i}=h\,\frac{2\pi(i-1)}{N_{\text{ions}}},\qquad\Delta z=\frac{L}{N_{\text{turns}}(N_{\text{ions}}-1)},
\end{equation}

\end_inset

with 
\begin_inset Formula $R$
\end_inset

 = 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
hel_radius
\end_layout

\end_inset

,
 
\begin_inset Formula $L$
\end_inset

 = 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
hel_length
\end_layout

\end_inset

,
 and 
\begin_inset Formula $h=\pm1$
\end_inset

 = 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
hand
\end_layout

\end_inset

 (right/left-handed).
 For a single turn 
\begin_inset Formula $L$
\end_inset

 is exactly the end-to-end length;
 for 
\begin_inset Formula $N_{\text{turns}}$
\end_inset

 turns the end-to-end length is 
\begin_inset Formula $L\,(N_{\text{sites}}-1)/\bigl(N_{\text{turns}}(N_{\text{ions}}-1)\bigr)$
\end_inset

,
 so the helix becomes slightly longer than 
\begin_inset Formula $L$
\end_inset

 (for example 
\begin_inset Formula $5.83$
\end_inset

 for 
\begin_inset Formula $L=5$
\end_inset

,
 
\begin_inset Formula $N_{\text{ions}}=4$
\end_inset

,
 
\begin_inset Formula $N_{\text{turns}}=2$
\end_inset

).
 Only unit vectors along bonds enter the Hamiltonian,
 so the SOC depends on the 
\emph on
shape
\emph default
 of the helix (the ratio of 
\begin_inset Formula $\Delta z$
\end_inset

 to 
\begin_inset Formula $R$
\end_inset

),
 not on its overall size.
\end_layout

\begin_layout Subsection
Hamiltonian
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
H=\sum_{i\sigma}\varepsilon\,c_{i\sigma}^{\dagger}c_{i\sigma}+t\sum_{i\sigma}\bigl(c_{i\sigma}^{\dagger}c_{i+1,\sigma}+\text{h.c.}\bigr)+\sum_{i}\bigl(c_{i}^{\dagger}\,\mathcal{V}_{i,i+2}\,c_{i+2}+\text{h.c.}\bigr)+\sum_{i}U_{i}\,n_{i\uparrow}n_{i\downarrow},
\end{equation}

\end_inset

with 
\begin_inset Formula $\varepsilon$
\end_inset

 = 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
E_CC
\end_layout

\end_inset

,
 
\begin_inset Formula $t$
\end_inset

 = 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
t_hop
\end_layout

\end_inset

,
 and the next-nearest-neighbour spin–orbit term (a 
\begin_inset Formula $2\times2$
\end_inset

 matrix in spin space) 
\begin_inset Formula 
\begin{equation}
\mathcal{V}_{i,i+2}=i\lambda\;\bigl(\hat{\mathbf{d}}_{i,i+1}\times\hat{\mathbf{d}}_{i,i+2}\bigr)\cdot\boldsymbol{\sigma},\qquad\hat{\mathbf{d}}_{i,j}=\frac{\mathbf{r}_{i}-\mathbf{r}_{j}}{|\mathbf{r}_{i}-\mathbf{r}_{j}|},
\end{equation}

\end_inset

where 
\begin_inset Formula $\lambda$
\end_inset

 = 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
lamb
\end_layout

\end_inset

 and 
\begin_inset Formula $\boldsymbol{\sigma}$
\end_inset

 are the Pauli matrices (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
soc_matrix_elements
\end_layout

\end_inset

).
 The non-interacting part is built by 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
build_helix_hamiltonian
\end_layout

\end_inset

;
 the Hubbard term enters only through the self-energy (Section
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand ref
reference "sec:sigma"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
 
\begin_inset Formula $U_{i}$
\end_inset

 = 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
U_int
\end_layout

\end_inset

 on every site,
 or one value per site from 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
hubbard_file
\end_layout

\end_inset

.
\end_layout


\begin_layout Standard
This is the helix model built by 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
build_helix_hamiltonian
\end_layout

\end_inset

.
 Nothing else in the code depends on it: any other single-particle Hamiltonian can be used instead, as described in Section 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:customH"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

.
\end_layout

\begin_layout Subsection
Multi-orbital Hamiltonians from DFTB+
\begin_inset CommandInset label
LatexCommand label
name "sec:dftb"

\end_inset

\end_layout

\begin_layout Standard
For a real molecule 
\begin_inset Formula $H$
\end_inset

 can come from DFTB+ (density-functional tight binding), which gives a minimal valence basis on every atom. Two routes are implemented: 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
hamiltonian = dftb_hs
\end_layout

\end_inset

 reads the DFTB+ Hamiltonian and overlap and adds the spin–orbit coupling itself (recommended), and 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
hamiltonian = dftb
\end_layout

\end_inset

 reads a ready-made orthogonal spin–orbit Hamiltonian written by the soc_dftb scripts (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
build_hamiltonian_from_dftb_hs
\end_layout

\end_inset

 and 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
build_hamiltonian_from_dftb
\end_layout

\end_inset

 in 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
src/hamiltonian.f90
\end_layout

\end_inset

). Examples: 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
examples/helicene_dftb_hs
\end_layout

\end_inset

 and 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
examples/helicene_dftb
\end_layout

\end_inset

.
\end_layout

\begin_layout Paragraph
Sites are orbitals.
\end_layout

\begin_layout Standard
Every atom carries the shells set by 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
max_angular_momentum
\end_layout

\end_inset

: an s shell, or s and p. The orbitals of an atom are numbered in the DFTB+ order s, 
\begin_inset Formula $p_{y}$
\end_inset

, 
\begin_inset Formula $p_{z}$
\end_inset

, 
\begin_inset Formula $p_{x}$
\end_inset

 (C: 4 orbitals, H: 1), atom after atom. A QUICHOTTE 
\emph on
site
\emph default
 is one spatial orbital, so the spin-orbital index is still 
\begin_inset Formula $2i-1$
\end_inset

 (orbital 
\begin_inset Formula $i$
\end_inset

, up) and 
\begin_inset Formula $2i$
\end_inset

 (orbital 
\begin_inset Formula $i$
\end_inset

, down), and everything that is per site (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
populations.dat
\end_layout

\end_inset

, 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
spectral_function.dat
\end_layout

\end_inset

, 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
hubbard_file
\end_layout

\end_inset

) is per orbital. The Hubbard term 
\begin_inset Formula $U_{i}\,n_{i\uparrow}n_{i\downarrow}$
\end_inset

 acts within each orbital (intra-orbital 
\begin_inset Formula $U$
\end_inset

); inter-orbital 
\begin_inset Formula $U'$
\end_inset

, Hund's 
\begin_inset Formula $J$
\end_inset

 and inter-site interactions are not included. Hopping, overlap and spin–orbit coupling connect the orbitals, so an electron scattered on one orbital propagates through all of them. Orbitals with 
\begin_inset Formula $U_{i}=0$
\end_inset

 cost no memory (Section 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:active"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

). 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
populations_atoms.dat
\end_layout

\end_inset

 adds the orbitals of each atom up and gives the orbital moment of its p shell (Section 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:equaltime"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
\end_layout

\begin_layout Paragraph
hamiltonian = dftb_hs (recommended).
\end_layout

\begin_layout Standard
Run DFTB+ 
\emph on
without
\emph default
 spin–orbit coupling and with 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
Scc = No
\end_layout

\end_inset

, with 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
Options { WriteHS = Yes }
\end_layout

\end_inset

. The Hubbard interaction is added by QUICHOTTE, so a self-consistent (SCC) Hamiltonian would count it twice. DFTB+ writes 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
hamsqr1.dat
\end_layout

\end_inset

 (
\begin_inset Formula $H_{0}$
\end_inset

) and 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
oversqr.dat
\end_layout

\end_inset

 (
\begin_inset Formula $S$
\end_inset

), real square matrices at the 
\begin_inset Formula $\Gamma$
\end_inset

 point in Hartree, and stops. The element of every atom is read from 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
xyz_file
\end_layout

\end_inset

 (first column, in the DFTB+ atom order). With the atomic spin–orbit operator on the p shells,
\end_layout

\begin_layout Standard

\begin_inset Formula 
\begin{equation}
\Lambda=\sum_{A}\xi_{A}\,\mathbf{L}_{A}\cdot\mathbf{S},\qquad(L_{k})_{ab}=-i\,\varepsilon_{kab}\quad(a,b\in\{x,y,z\}),\qquad\mathbf{S}=\tfrac{1}{2}\boldsymbol{\sigma},
\end{equation}

\end_inset

QUICHOTTE builds the orthogonal (Löwdin) spin–orbit Hamiltonian
\end_layout

\begin_layout Standard

\begin_inset Formula 
\begin{equation}
H=\bigl(S^{-1/2}\otimes\mathbb{1}\bigr)\Bigl[H_{0}\otimes\mathbb{1}+\tfrac{1}{2}\bigl(\tilde{S}\Lambda+\Lambda\tilde{S}\bigr)\Bigr]\bigl(S^{-1/2}\otimes\mathbb{1}\bigr),\qquad\tilde{S}=S\otimes\mathbb{1},\label{eq:dftbhs}
\end{equation}

\end_inset

converted to eV (1 Ha = 27.211386245988 eV). The bracket is the 
\emph on
dual
\emph default
 form DFTB+ uses for a non-orthogonal basis; 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
soc_form = onsite
\end_layout

\end_inset

 puts 
\begin_inset Formula $\Lambda$
\end_inset

 in its place. 
\begin_inset Formula $S^{-1/2}$
\end_inset

 comes from the eigenvectors of 
\begin_inset Formula $S$
\end_inset

; the smallest eigenvalue of 
\begin_inset Formula $S$
\end_inset

 is printed and the run stops if it is below 
\begin_inset Formula $10^{-8}$
\end_inset

. The Löwdin orbitals are the orthogonal orbitals closest (in the least-squares sense) to the atomic ones, so they keep their s/p character with small admixtures from the neighbours. 
\begin_inset Formula $\xi_{A}$
\end_inset

 is 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
soc_xi
\end_layout

\end_inset

 (eV, per element; 0 for elements not listed). For carbon 2p, 
\begin_inset Formula $\xi=0.312$
\end_inset

 mHa 
\begin_inset Formula $=8.49$
\end_inset

 meV (Jha and Heine); note that 0.000312 entered in eV is 27 times too small. This 
\begin_inset Formula $H$
\end_inset

 is exactly time-reversal symmetric.
\end_layout

\begin_layout Paragraph
hamiltonian = dftb (block file).
\end_layout

\begin_layout Standard
Reads the orthogonal spin–orbit Hamiltonian written by 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
export_fortran_blocks
\end_layout

\end_inset

 of the soc_dftb pipeline: blocks 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
BLOCK n | Atom_I: a Atom_J: b | Dist: d | Dim: (2n_a)x(2n_b)
\end_layout

\end_inset

, each followed by one 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
re im
\end_layout

\end_inset

 line per element, rows over (orbital, spin) of the atom with spin fastest, in eV. The atoms and their orbitals come from the block headers; every atom needs its on-site block. That matrix is rebuilt from rounded eigenvalues and eigenvectors and breaks time reversal by about 
\begin_inset Formula $10^{-5}$
\end_inset

 eV, a sizeable fraction of the spin–orbit coupling, so prefer 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
dftb_hs
\end_layout

\end_inset

.
\end_layout

\begin_layout Paragraph
Checks.
\end_layout

\begin_layout Standard
Write each 
\begin_inset Formula $2\times2$
\end_inset

 spin block as 
\begin_inset Formula $H_{ij}=h_{ij}^{0}\mathbf{1}+\mathbf{h}_{ij}\cdot\boldsymbol{\sigma}$
\end_inset

. Time reversal requires 
\begin_inset Formula $h^{0}$
\end_inset

 real and 
\begin_inset Formula $\mathbf{h}$
\end_inset

 imaginary; 
\begin_inset Formula $\operatorname{Im}\mathbf{h}$
\end_inset

 is the spin–orbit coupling. Both routes print 
\begin_inset Formula $\max|\operatorname{Im}h^{0}|$
\end_inset

, 
\begin_inset Formula $\max|\operatorname{Re}\mathbf{h}|$
\end_inset

 and 
\begin_inset Formula $\max|\operatorname{Im}\mathbf{h}|$
\end_inset

 (with a warning above 
\begin_inset Formula $10^{-8}$
\end_inset

 eV), and 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
write_hamiltonian = T
\end_layout

\end_inset

 writes 
\begin_inset Formula $H$
\end_inset

 in full precision to 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
hamiltonian_matrix.dat
\end_layout

\end_inset

. For hexahelicene (42 atoms, 120 orbitals) the dftb_hs Hamiltonian agrees with an independent construction to 
\begin_inset Formula $5\times10^{-14}$
\end_inset

 eV, and its eigenvalues with the soc_dftb Hamiltonian to 
\begin_inset Formula $2\times10^{-6}$
\end_inset

 eV.
\end_layout

\begin_layout Subsection
Leads
\begin_inset CommandInset label
LatexCommand label
name "sec:leads"

\end_inset

\end_layout


\begin_layout Standard
Both leads are in the wide-band limit. The left lead couples with a spin-dependent strength to every orbital 
\begin_inset Formula $i$
\end_inset

 of the contact atoms 
\begin_inset Formula $\mathcal{L}$
\end_inset

 (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
lead_left_atoms
\end_layout

\end_inset

, default: the first atom), the right lead to every orbital of 
\begin_inset Formula $\mathcal{R}$
\end_inset

 (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
lead_right_atoms
\end_layout

\end_inset

, default: the last atom); 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
setup_leads
\end_layout

\end_inset

 in 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
src/input_output.f90
\end_layout

\end_inset

. For the helix, 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
xyz
\end_layout

\end_inset

 and 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
custom
\end_layout

\end_inset

 models an atom is one site, so by default the leads sit on site 1 and on the last site. An atom cannot be in both lists.
\begin_inset Formula 
\begin{equation}
\Gamma_{L}=\sum_{i\in\mathcal{L}}\bigl(\Gamma_{L\uparrow}\,|i{\uparrow}\rangle\langle i{\uparrow}|+\Gamma_{L\downarrow}\,|i{\downarrow}\rangle\langle i{\downarrow}|\bigr),\qquad\Gamma_{R}=\Gamma_{R}\sum_{i\in\mathcal{R}}\sum_{\sigma}|i\sigma\rangle\langle i\sigma|,
\end{equation}

\end_inset

(
\begin_inset Formula $\Gamma_{L\uparrow}$
\end_inset

 = 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
GammaL_up
\end_layout

\end_inset

, 
\begin_inset Formula $\Gamma_{L\downarrow}$
\end_inset

 = 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
GammaL_down
\end_layout

\end_inset

, 
\begin_inset Formula $\Gamma_{R}$
\end_inset

 = 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
GammaR
\end_layout

\end_inset

). Their retarded self-energy is 
\begin_inset Formula $\Sigma_{\text{leads}}^{r}=-\tfrac{i}{2}(\Gamma_{L}+\Gamma_{R})$
\end_inset

.
 The bias is applied to the 
\emph on
left
\emph default
 lead only:
 
\begin_inset Formula 
\begin{equation}
f_{L}(\omega)=\frac{1}{e^{\beta(\omega-\mu+V)}+1},\qquad f_{R}(\omega)=\frac{1}{e^{\beta(\omega-\mu)}+1},\qquad\beta=1/k_{B}T,
\end{equation}

\end_inset

i.e.
\begin_inset space \space{}
\end_inset


\begin_inset Formula $\mu_{L}=\mu-V$
\end_inset

,
 
\begin_inset Formula $\mu_{R}=\mu$
\end_inset

 (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
fermi
\end_layout

\end_inset

 in 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
src/green_functions.f90
\end_layout

\end_inset

).
 Because the bias is asymmetric,
 the 
\begin_inset Formula $I$
\end_inset

–
\begin_inset Formula $V$
\end_inset

 curve need not be odd in 
\begin_inset Formula $V$
\end_inset

 once 
\begin_inset Formula $U\neq0$
\end_inset

.
\end_layout

\begin_layout Section
Non-equilibrium Green's functions
\end_layout

\begin_layout Subsection
Energy grid
\end_layout

\begin_layout Standard
All functions of energy are stored on the uniform grid 
\begin_inset Formula 
\begin{equation}
\omega_{k}=\omega_{\text{init}}+k\,\delta,\qquad k=1,\dots,N_{\omega},\qquad\omega_{\text{init}}=\epsilon_{\text{min}}-\code{dw},\qquad N_{\omega}=\Bigl\lfloor\frac{\epsilon_{\text{max}}+\code{up}-\omega_{\text{init}}}{\delta}\Bigr\rfloor,
\end{equation}

\end_inset

where 
\begin_inset Formula $\epsilon_{\text{min,max}}$
\end_inset

 are the extreme eigenvalues of 
\begin_inset Formula $H$
\end_inset

 and 
\begin_inset Formula $\delta$
\end_inset

 = 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
delta
\end_layout

\end_inset

.
 The margins 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
dw
\end_layout

\end_inset

,
 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
up
\end_layout

\end_inset

 must contain the broadened spectrum (the sanity check of Section
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand ref
reference "sec:sanity"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

 warns if spectral weight is missing).
\end_layout

\begin_layout Subsection
Dyson and Keldysh equations
\end_layout

\begin_layout Standard
At every grid energy (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
G_at_energy
\end_layout

\end_inset

 in 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
src/scf.f90
\end_layout

\end_inset

):
 
\begin_inset Formula 
\begin{align}
\Gr(\omega) & =\Bigl[\hbar\omega-H+\tfrac{i}{2\hbar}(\Gamma_{L}+\Gamma_{R})-\Sigma^{r}(\omega)\Bigr]^{-1},\qquad\Ga(\omega)=\bigl[\Gr(\omega)\bigr]^{\dagger},\label{eq:dyson}\\
\Gl(\omega) & =\Gr(\omega)\Bigl[\tfrac{i}{\hbar}\bigl(f_{L}(\omega)\Gamma_{L}+f_{R}(\omega)\Gamma_{R}\bigr)+\Sigma^{<}(\omega)\Bigr]\Ga(\omega),\label{eq:keldysh}\\
\Gg(\omega) & =\Gl(\omega)+\Gr(\omega)-\Ga(\omega).\label{eq:greater}
\end{align}

\end_inset

The non-interacting functions 
\begin_inset Formula $G_{0}$
\end_inset

 (the starting guess) are the same equations with 
\begin_inset Formula $\Sigma=0$
\end_inset

. 
\begin_inset Formula $\Gr(\omega)$
\end_inset

 is inverted in full, but only one energy at a time per thread, and only the blocks the self-energy and the observables need are kept (Section 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:active"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

).
\end_layout


\begin_layout Subsection
Equal-time quantities
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\Gl(t{=}0)=\frac{\delta}{2\pi}\sum_{k}\Gl(\omega_{k}),\qquad n_{i\sigma}=-i\hbar\,\Gl_{i\sigma,i\sigma}(t{=}0),\qquad\langle S_{\alpha}\rangle_{i}=-\frac{i\hbar^{2}}{2}\Tr_{\sigma}\!\bigl[\sigma_{\alpha}\,\Gl_{ii}(t{=}0)\bigr],
\end{equation}

\end_inset

where 
\begin_inset Formula $\Gl_{ii}$
\end_inset

 is the 
\begin_inset Formula $2\times2$
\end_inset

 spin block of site 
\begin_inset Formula $i$
\end_inset

 (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
equal_time_lesser
\end_layout

\end_inset

,
 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
spin_texture
\end_layout

\end_inset

).
\end_layout

\begin_layout Standard
\begin_inset CommandInset label
LatexCommand label
name "sec:equaltime"

\end_inset


\end_layout

\begin_layout Standard
All observables are taken from one final sweep over the grid with the converged self-energies (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
solve_scf
\end_layout

\end_inset

). For multi-orbital atoms 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
atom_texture
\end_layout

\end_inset

 also sums 
\begin_inset Formula $n_{i\sigma}$
\end_inset

 and 
\begin_inset Formula $\langle S_{\alpha}\rangle_{i}$
\end_inset

 over the orbitals of each atom 
\begin_inset Formula $A$
\end_inset

 and gives the orbital moment of its p shell,
\begin_inset Formula 
\begin{equation}
\rho_{ab}^{A}=\sum_{\sigma}\langle c_{a\sigma}^{\dagger}c_{b\sigma}\rangle=-i\hbar\sum_{\sigma}\Gl_{b\sigma,a\sigma}(t{=}0),\qquad\langle L_{k}\rangle_{A}=\sum_{a,b\in p(A)}(L_{k})_{ab}\,\rho_{ab}^{A}\quad[\hbar],
\end{equation}

\end_inset

with 
\begin_inset Formula $(L_{k})_{ab}=-i\varepsilon_{kab}$
\end_inset

 in the (
\begin_inset Formula $p_{x}$
\end_inset

, 
\begin_inset Formula $p_{y}$
\end_inset

, 
\begin_inset Formula $p_{z}$
\end_inset

) basis (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
populations_atoms.dat
\end_layout

\end_inset

). It needs the intra-atom blocks of 
\begin_inset Formula $\Gl(t{=}0)$
\end_inset

, which the final sweep keeps for multi-orbital atoms. 
\begin_inset Formula $\mathbf{L}$
\end_inset

 is evaluated in the Löwdin orbitals, i.e. it is the orbital moment of those orbitals, close to but not identical with that of the bare atomic p orbitals. Spin–orbit coupling and a bias together give a current-induced 
\begin_inset Formula $\langle\mathbf{L}\rangle$
\end_inset

, odd in 
\begin_inset Formula $V$
\end_inset

.
\end_layout

\begin_layout Subsection
Current
\end_layout

\begin_layout Standard
The spin-resolved particle current through the left lead is (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
Current
\end_layout

\end_inset

,
 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
G_at_energy
\end_layout

\end_inset

 (final sweep) in 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
src/scf.f90
\end_layout

\end_inset

) 
\begin_inset Formula 
\begin{equation}
J_{\sigma}=\frac{1}{\hbar}\frac{\delta}{2\pi}\sum_{k}\operatorname{Re}\Tr_{\sigma}\Bigl\{ i\,\Gamma_{L}\Bigl[\bigl(f_{L}(\omega_{k})-1\bigr)\Gl(\omega_{k})-f_{L}(\omega_{k})\,\Gg(\omega_{k})\Bigr]\Bigr\},
\end{equation}

\end_inset

where 
\begin_inset Formula $\Tr_{\sigma}$
\end_inset

 sums over the spin-
\begin_inset Formula $\sigma$
\end_inset

 orbitals only.
 Using Eq.
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:greater"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

,
 the bracket is 
\begin_inset Formula $-\bigl[\Gl+f_{L}(\Gr-\Ga)\bigr]$
\end_inset

,
 so this is minus the Meir–Wingreen expression 
\begin_inset Formula $\tfrac{i}{\hbar}\int\!\tfrac{d\omega}{2\pi}\Tr\{\Gamma_{L}[\Gl+f_{L}(\Gr-\Ga)]\}$
\end_inset

.
 With this sign the current is positive for 
\begin_inset Formula $V>0$
\end_inset

.
 The output also gives 
\begin_inset Formula $J=J_{\uparrow}+J_{\downarrow}$
\end_inset

;
 the spin polarisation is 
\begin_inset Formula $J_{\uparrow}-J_{\downarrow}$
\end_inset

.
\end_layout

\begin_layout Section
Interaction self-energies
\end_layout

\begin_layout Standard
\begin_inset CommandInset label
LatexCommand label
name "sec:sigma"

\end_inset


\end_layout

\begin_layout Standard
All self-energies are functionals of the 
\emph on
input
\emph default
 Green's functions of the current SCF step,
 
\begin_inset Formula $G_{\text{in}}$
\end_inset

 (Section
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand ref
reference "sec:scf"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

),
 and are evaluated in 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
src/self_energies.f90
\end_layout

\end_inset

.
\end_layout

\begin_layout Subsection
First order (Hartree–Fock),
 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
order
\end_layout

\end_inset

 
\begin_inset Formula $\ge1$
\end_inset


\end_layout

\begin_layout Standard
The first-order term is static and local to each site.
 With 
\begin_inset Formula $\rho_{i}=-i\hbar\,\Gl_{ii}(t{=}0)$
\end_inset

 the 
\begin_inset Formula $2\times2$
\end_inset

 density matrix of site 
\begin_inset Formula $i$
\end_inset

,
 
\begin_inset Formula 
\begin{equation}
\Sigma_{i\sigma,i\sigma'}^{(1)}=i\hbar\,U_{i}\Bigl[\Gl_{i\sigma,i\sigma'}(0)-\delta_{\sigma\sigma'}\Tr\Gl_{ii}(0)\Bigr]\;=\;U_{i}\bigl[\delta_{\sigma\sigma'}\Tr\rho_{i}-\rho_{i,\sigma\sigma'}\bigr],
\end{equation}

\end_inset

i.e.
\begin_inset space \space{}
\end_inset


\begin_inset Formula $\Sigma_{\uparrow\uparrow}=Un_{\downarrow}$
\end_inset

,
 
\begin_inset Formula $\Sigma_{\downarrow\downarrow}=Un_{\uparrow}$
\end_inset

 (Hartree) and 
\begin_inset Formula $\Sigma_{\uparrow\downarrow}=-U\rho_{\uparrow\downarrow}$
\end_inset

 (Fock).
 It has no lesser component (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
sigma_first_order
\end_layout

\end_inset

).
\end_layout

\begin_layout Subsection
Second order,
 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
order
\end_layout

\end_inset

 
\begin_inset Formula $=2$
\end_inset


\end_layout

\begin_layout Standard
The second-order diagrams couple every pair of sites 
\begin_inset Formula $(i,j)$
\end_inset

.
 Writing 
\begin_inset Formula $G_{ij}$
\end_inset

 for the 
\begin_inset Formula $2\times2$
\end_inset

 spin block between sites 
\begin_inset Formula $i$
\end_inset

 and 
\begin_inset Formula $j$
\end_inset

,
 and working in the time domain (the variable conjugate to 
\begin_inset Formula $\omega$
\end_inset

 on the grid):
 
\begin_inset Formula 
\begin{align}
\Sigma_{ij}^{(2)r}(t) & =\hbar^{2}U_{i}U_{j}\Bigl\{\Gr_{ij}(t)\,\adj\!\bigl[\Gl_{ji}(-t)\,\Gg_{ij}(t)\bigr]+\Gl_{ij}(t)\,\adj\!\bigl[\Gl_{ji}(-t)\,\Gr_{ij}(t)+\Ga_{ji}(-t)\,\Gl_{ij}(t)\bigr]\Bigr\},\\
\Sigma_{ij}^{(2)<}(t) & =\hbar^{2}U_{i}U_{j}\;\Gl_{ij}(t)\,\adj\!\bigl[\Gg_{ji}(-t)\,\Gl_{ij}(t)\bigr],
\end{align}

\end_inset

with the 
\begin_inset Formula $2\times2$
\end_inset

 adjugate 
\begin_inset Formula $\adj M=(\Tr M)\,\mathbb{1}-M$
\end_inset

,
 i.e.
\begin_inset space \space{}
\end_inset

direct minus exchange (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
adj2
\end_layout

\end_inset

).
 Each product of three functions is a double sum over the grid in energy,
 
\begin_inset Formula $\sum_{k_{1},k_{2}}A(\omega_{k_{1}})B(\omega_{k_{2}})C(\omega-\omega_{k_{1}}+\omega_{k_{2}})$
\end_inset

,
 weighted by 
\begin_inset Formula $(\delta/2\pi)^{2}$
\end_inset

.
\end_layout

\begin_layout Paragraph
FFT evaluation.
\end_layout

\begin_layout Standard
QUICHOTTE evaluates these sums for all energies at once by fast Fourier transforms (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
sigma2_compute
\end_layout

\end_inset

,
 FFTW).
 Each element of 
\begin_inset Formula $\Gr$
\end_inset

 and 
\begin_inset Formula $\Gl$
\end_inset

 is zero-padded to length 
\begin_inset Formula $N_{f}\ge2N_{\omega}-1$
\end_inset

 (the smallest such length with prime factors 
\begin_inset Formula $2,3,5,7$
\end_inset

),
 transformed,
 multiplied as above,
 and transformed back.
 The zero padding makes the result 
\emph on
identical
\emph default
 to the direct discrete sums,
 so it is not an approximation.
 Only 
\begin_inset Formula $\Gr$
\end_inset

 and 
\begin_inset Formula $\Gl$
\end_inset

 are transformed;
 
\begin_inset Formula $\Ga_{ij}(t)=[\Gr_{ji}(-t)]^{\dagger}$
\end_inset

 and 
\begin_inset Formula $\Gg=\Gl+\Gr-\Ga$
\end_inset

 follow exactly.
 The cost per SCF step is 
\begin_inset Formula $\mathcal{O}(N_{\text{sites}}^{2}\,N_{f}\log N_{f})$
\end_inset

 instead of 
\begin_inset Formula $\mathcal{O}(N_{\text{sites}}^{2}N_{\omega}^{2})$
\end_inset

.
\end_layout

\begin_layout Subsection
Total self-energy
\end_layout

\begin_layout Standard

\begin_inset Formula 
\begin{equation}
\Sigma^{r}=\Sigma^{(1)}+\Sigma^{(2)r},\qquad\Sigma^{<}=\Sigma^{(2)<},
\end{equation}

\end_inset

including only the terms up to 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
order
\end_layout

\end_inset

. Both vanish outside the block of the interacting orbitals; they are added to the lead terms in 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
G_at_energy
\end_layout

\end_inset

 (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
src/scf.f90
\end_layout

\end_inset

).
\end_layout


\begin_layout Section
Self-consistency
\end_layout

\begin_layout Standard
\begin_inset CommandInset label
LatexCommand label
name "sec:scf"

\end_inset


\end_layout

\begin_layout Subsection
The fixed-point problem
\end_layout

\begin_layout Standard
At each voltage the code solves 
\begin_inset Formula $G=\mathcal{F}[G]$
\end_inset

,
 where 
\begin_inset Formula $\mathcal{F}$
\end_inset

 builds 
\begin_inset Formula $\Sigma[G]$
\end_inset

 and then applies Eqs.
\begin_inset space ~
\end_inset


\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:dyson"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

–
\begin_inset CommandInset ref
LatexCommand eqref
reference "eq:greater"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

.
 
\begin_inset Formula $\Gr$
\end_inset

 and 
\begin_inset Formula $\Gl$
\end_inset

 on the active block (Section 
\begin_inset CommandInset ref
LatexCommand ref
reference "sec:active"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) and the whole grid are packed into one real vector 
\begin_inset Formula $x$
\end_inset

 (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
pack_gf
\end_layout

\end_inset

 in 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
common/linear_algebra.f90
\end_layout

\end_inset

).
 Per energy the vector holds 
\begin_inset Formula 
\[
\bigl[\operatorname{Re}\Gr_{ab}\;(n_{A}^{2})\;\big|\;\operatorname{Im}\Gr_{ab}\;(n_{A}^{2})\;\big|\;\operatorname{Re}\Gl_{a<b}\;\big|\;\operatorname{Im}\Gl_{a\le b}\bigr].
\]

\end_inset

Only the independent half of 
\begin_inset Formula $\Gl$
\end_inset

 is stored,
 because 
\begin_inset Formula $\Gl$
\end_inset

 is anti-Hermitian,
 
\begin_inset Formula $\Gl_{ba}=-\bigl(\Gl_{ab}\bigr)^{*}$
\end_inset

,
 so its diagonal is purely imaginary.
 The residual is 
\begin_inset Formula $F(x)=x_{\text{out}}(x)-x$
\end_inset

 (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
scf_residual2
\end_layout

\end_inset

).
\end_layout

\begin_layout Standard
This is order 2. At order 1 the self-energy depends only on the on-site 
\begin_inset Formula $2\times2$
\end_inset

 blocks of 
\begin_inset Formula $\Gl(t{=}0)$
\end_inset

 on the interacting orbitals, so those are mixed instead: a vector of 8 real numbers per interacting orbital (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
scf_residual1
\end_layout

\end_inset

). The fixed point is the same, and it is reached in fewer steps. At order 0 there is nothing to solve.
\end_layout


\begin_layout Subsection
Active subspace, final sweep and memory
\begin_inset CommandInset label
LatexCommand label
name "sec:active"

\end_inset

\end_layout

\begin_layout Standard
The self-energies are non-zero only on the 
\emph on
interacting
\emph default
 orbitals (
\begin_inset Formula $U_{i}\neq0$
\end_inset

), and the current only needs the left-contact block. QUICHOTTE therefore stores Green's functions only on the 
\emph on
active
\emph default
 states 
\begin_inset Formula $A$
\end_inset

: the interacting orbitals and the contact orbitals, 
\begin_inset Formula $n_{A}$
\end_inset

 spin-orbitals in all (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
setup_storage
\end_layout

\end_inset

 in 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
src/green_functions.f90
\end_layout

\end_inset

). At each energy the full 
\begin_inset Formula $\Gr$
\end_inset

 is formed and inverted, one energy per thread, and then reduced:
\end_layout

\begin_layout Itemize
order 2: 
\begin_inset Formula $\Gr_{AA}$
\end_inset

 and 
\begin_inset Formula $\Gl_{AA}=\Gr_{AA}\,\Sigma_{AA}^{<}\,\Ga_{AA}$
\end_inset

, where 
\begin_inset Formula $\Sigma^{<}$
\end_inset

 (leads plus second order) lives on 
\begin_inset Formula $A$
\end_inset

; these, 
\begin_inset Formula $\Sigma^{(2)}$
\end_inset

 and the FFT work arrays are 
\begin_inset Formula $\propto n_{A}^{2}N_{\omega}$
\end_inset

;
\end_layout

\begin_layout Itemize
order 1: only the on-site 
\begin_inset Formula $2\times2$
\end_inset

 blocks of 
\begin_inset Formula $\Gl$
\end_inset

 on the interacting orbitals, summed over energy;
\end_layout

\begin_layout Itemize
order 0: nothing but the observables.
\end_layout

\begin_layout Standard
After convergence one 
\emph on
final sweep
\emph default
 with the converged self-energies gives every observable: the current from the left-contact block, 
\begin_inset Formula $A_{aa}(\omega)$
\end_inset

 and the on-site blocks of 
\begin_inset Formula $\Gl(t{=}0)$
\end_inset

 of every orbital, and for multi-orbital atoms the intra-atom blocks. The run prints its estimate (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
Memory: stored arrays ~ ... GB
\end_layout

\end_inset

). A 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
hubbard_file
\end_layout

\end_inset

 with 
\begin_inset Formula $U$
\end_inset

 on part of the molecule therefore saves memory and time in proportion. Measured on a 24-site helix (
\begin_inset Formula $\delta=0.01$
\end_inset

 eV), against the version that stored every 
\begin_inset Formula $G$
\end_inset

 in full:
\end_layout

\begin_layout Itemize
order 2, 
\begin_inset Formula $U$
\end_inset

 on every site: 0.85 GB to 0.48 GB, same number of steps;
\end_layout

\begin_layout Itemize
order 2, 
\begin_inset Formula $U$
\end_inset

 on 8 of 24 sites: 0.85 GB to 0.09 GB, 3.5 times faster;
\end_layout

\begin_layout Itemize
order 1: 0.77 GB to 0.009 GB; order 0: 0.14 GB to 0.008 GB.
\end_layout

\begin_layout Standard
With 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
broyden_single_precision = F
\end_layout

\end_inset

 the order-2 SCF histories are bit-identical to that version, and the observables agree to 
\begin_inset Formula $10^{-8}$
\end_inset

 (they now come from the final sweep instead of the last SCF input).
\end_layout

\begin_layout Subsection
Modified Broyden mixing
\end_layout

\begin_layout Standard
\begin_inset Formula $F(x)=0$
\end_inset

 is solved by Johnson's modified Broyden method (D.
\begin_inset space ~
\end_inset

D.
\begin_inset space ~
\end_inset

Johnson,
 Phys.
\begin_inset space \space{}
\end_inset

Rev.
\begin_inset space \space{}
\end_inset

B 
\series bold
38
\series default
,
 12807 (1988);
 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
common/broyden_mixing.f90
\end_layout

\end_inset

).
 With 
\begin_inset Formula $\alpha$
\end_inset

 = 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
alpha_mix
\end_layout

\end_inset

,
 
\begin_inset Formula 
\begin{align}
\Delta F_{k} & =\frac{F_{k}-F_{k-1}}{\|F_{k}-F_{k-1}\|},\qquad u_{k}=\alpha\,\Delta F_{k}+\frac{x_{k}-x_{k-1}}{\|F_{k}-F_{k-1}\|},\\
\gamma & =\bigl(w_{0}^{2}\,\mathbb{1}+\Delta F^{T}\Delta F\bigr)^{-1}\Delta F^{T}F_{n},\qquad w_{0}=0.01,\\
x_{n+1} & =x_{n}+\alpha F_{n}-\sum_{k}\gamma_{k}\,u_{k}.
\end{align}

\end_inset

The last 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
nhist
\end_layout

\end_inset

 pairs 
\begin_inset Formula $(\Delta F_{k},u_{k})$
\end_inset

 are kept in a ring buffer (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
nhist
\end_layout

\end_inset


\begin_inset space ~
\end_inset


\begin_inset Formula $=0$
\end_inset

 gives plain linear mixing).
 No Jacobian is stored,
 so each step costs one evaluation of 
\begin_inset Formula $F$
\end_inset

 plus 
\begin_inset Formula $\mathcal{O}(n\cdot\code{nhist})$
\end_inset

 BLAS work,
 with 
\begin_inset Formula $n$
\end_inset

 the vector length.
\end_layout

\begin_layout Standard
With 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
broyden_single_precision = T
\end_layout

\end_inset

 (default) the history 
\begin_inset Formula $(\Delta F_{k},u_{k})$
\end_inset

 is kept in single precision, which halves its memory; 
\begin_inset Formula $x$
\end_inset

, 
\begin_inset Formula $F$
\end_inset

 and all dot products stay in double precision. In the tests this changes neither the number of steps nor the solution (differences below 
\begin_inset Formula $10^{-13}$
\end_inset

).
\end_layout


\begin_layout Subsection
Convergence
\end_layout

\begin_layout Standard
A voltage is converged when 
\begin_inset Formula $\max_{m}|F_{m}|<\code{tolf}$
\end_inset

.
 This is tested 
\emph on
before
\emph default
 mixing,
 so the stored solution is an input whose own output differs from it by less than 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
tolf
\end_layout

\end_inset

 in every component.
 At most 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
maxscf
\end_layout

\end_inset

 steps are taken.
 At order 1 the threshold is 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
tolf_order1
\end_layout

\end_inset

 (
\begin_inset Formula $10^{-8}$
\end_inset

 by default).
 The history of every voltage is in 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
scf_V_<V>.dat
\end_layout

\end_inset

.
\end_layout

\begin_layout Subsection
Sanity checks
\end_layout

\begin_layout Standard
\begin_inset CommandInset label
LatexCommand label
name "sec:sanity"

\end_inset

 After every step (
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
common/scf_checks.f90
\end_layout

\end_inset

),
 for every spin-orbital 
\begin_inset Formula $a$
\end_inset

:
 
\begin_inset Formula 
\[
n_{a}=-i\hbar\tfrac{\delta}{2\pi}{\textstyle \sum_{k}\Gl_{aa}(\omega_{k}),\qquad W_{a}=-\hbar\tfrac{\delta}{\pi}{\textstyle \sum_{k}\operatorname{Im}\Gr_{aa}(\omega_{k}).}}
\]

\end_inset


\end_layout

\begin_layout Itemize

\series bold
Runaway
\series default
 (NaN,
 or 
\begin_inset Formula $n_{a}\notin[-1,2]$
\end_inset

):
 the SCF for this voltage is abandoned.
 
\end_layout

\begin_layout Itemize

\series bold
Unphysical
\series default
 (
\begin_inset Formula $n_{a}\notin[-0.05,1.05]$
\end_inset

 or 
\begin_inset Formula $W_{a}<0.5$
\end_inset

):
 a converged solution of this kind is 
\emph on
not
\emph default
 accepted.
 
\begin_inset Formula $W_{a}<1$
\end_inset

 usually means the grid margins 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
dw
\end_layout

\end_inset

,
 
\begin_inset Flex Code
status collapsed

\begin_layout Plain Layout
up
\end_layout

\end_inset

 are too small.
 
\end_layout

