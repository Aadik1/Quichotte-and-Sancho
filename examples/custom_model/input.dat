# =============================================================================
# input.dat  --  QUICHOTTE (bin/quichotte.x) with YOUR OWN Hamiltonian
#
# hamiltonian = custom runs build_custom_hamiltonian, the last routine in
# src/hamiltonian.f90. As shipped it is a plain spin-degenerate chain
# (on-site E_CC, hopping t_hop, no SOC), so this file runs straight away.
# To use your own model (manual: "Using your own Hamiltonian"):
#   1. replace the body of build_custom_hamiltonian with your model
#      (new parameters: declare in src/parameters.f90, read in read_input)
#   2. set N_sites below to the number of sites of your model
#   3. make, run, check info_Hamiltonian.dat, then make test
# The helix keys (N_ions, N_turns, hel_length, hel_radius, hand) and lamb are
# not needed here.
#
# Format: key = value, one per line. '#' starts a comment. Order does not matter.
# Energies in eV, voltages in V, temperature in K (hbar = e = 1).
# =============================================================================

# --- voltage sweep ------------------------------------------------------------
V     = -1.d0        # first voltage
Vf    =  1.d0        # last voltage
delv  =  0.05        # voltage step  -> (Vf-V)/delv + 1 voltages
T     = 300.d0       # temperature of both leads [K]
mu    = 2            # chemical potential at V = 0 (bias shifts the LEFT lead)

# --- which Hamiltonian ----------------------------------------------------------
hamiltonian = custom # build_custom_hamiltonian in src/hamiltonian.f90
N_sites     = 8      # number of sites of YOUR model (2*N_sites spin-orbitals)

# --- parameters used by the shipped template -------------------------------------
E_CC    =  2.d0      # on-site energy
t_hop   = -0.4d0     # nearest-neighbour hopping
U_int   =  0.8d0     # Hubbard U on every site
# hubbard_file = U_per_site.dat   # optional: one U per site (overrides U_int)
# my_key = ...                    # parameters of your own model go here

# --- lead couplings -------------------------------------------------------------
GammaL_up   = 1.5d0  # left lead -> site 1, spin up
GammaL_down = 1.d0   # left lead -> site 1, spin down
GammaR      = 1.d0   # right lead -> site N_sites, both spins

# --- interactions and energy grid -----------------------------------------------
order = 2            # 0 = non-interacting, 1 = Hartree-Fock, 2 = second order
dw    = 1            # grid starts dw below the lowest eigenvalue of H
up    = 1            # grid ends up above the highest eigenvalue of H
delta = 0.01         # grid spacing

# --- SCF (Broyden mixing); all optional, defaults shown --------------------------
alpha_mix = 0.5d0    # linear mixing weight
nhist     = 16       # Broyden history length (0 = plain linear mixing)
maxscf    = 300      # max SCF iterations per voltage
tolf      = 1.d-6    # converged when max|x_out - x| < tolf
continuation = T     # start each voltage from the previous converged one
