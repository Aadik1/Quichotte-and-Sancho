# QUICHOTTE run: 4 x 2 helix, order 2 (parameters of the original inputSOC.dat)
# Run:  cd runs/helix_4x2_order2 && OMP_NUM_THREADS=4 ../../bin/quichotte.x

# voltage sweep
V     = -1.d0
Vf    =  1.d0
delv  =  0.05
T     = 300.d0
mu    = 2

# model
hamiltonian = helix
N_ions     = 4
N_turns    = 2
hel_length = 5.d0
hel_radius = 1.d0
hand       = 1
E_CC  =  2.d0
t_hop = -0.4d0
lamb  =  0.05d0
U_int =  0.8d0

# leads
GammaL_up   = 1.5d0
GammaL_down = 1.d0
GammaR      = 1.d0

# interactions and energy grid
order = 2
dw    = 1
up    = 1
delta = 0.01

# SCF
alpha_mix = 0.5d0
