# QUICHOTTE run: 22-site alpha-helical peptide, order 2
# Run:  cd runs/peptide22_R_up && OMP_NUM_THREADS=4 ../../bin/quichotte.x

# voltage sweep
V     = -0.5d0
Vf    =  0.5d0
delv  =  0.05
T     = 300.d0
mu    = 2

# model
hamiltonian = peptide
N_sites    = 10
hel_radius = 2.5d0
pep_twist  = 100.d0
pep_rise   = 1.5d0
hand       = 1
hop_range  = 4
hop_decay  = 0.9d0
soc_model  = radial
E_CC  =  2.d0
t_hop = -0.4d0
lamb  =  0.05d0
U_int =  0.8d0

# leads
GammaL_up   = 0.05d0
GammaL_down = 0.1d0
GammaR      = 0.1d0

# interactions and energy grid
order = 2
dw    = 1
up    = 1
delta = 0.001

# SCF
alpha_mix = 0.5d0