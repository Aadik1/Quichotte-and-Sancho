# Error test: an atom in both lead_left_atoms and lead_right_atoms must stop with exit code 1
# Fixture: atoms C1, C2, H27 of the soc_dftb hexahelicene (9 orbitals); leads on C1 and on C2 + H.
hamiltonian = dftb
ham_file = dftb_CCH.txt
lead_left_atoms = 1
lead_right_atoms = 1:3
T = 300.d0
V = -0.4d0
Vf = 0.4d0
delv = 0.4d0
mu = -1.0d0
order = 0
U_int = 0.5d0
GammaL_up = 1.0d0
GammaL_down = 0.8d0
GammaR = 1.0d0
dw = 1
up = 1
delta = 0.05
